{
  "expo": {
    "name": "kuran-kerim-diyor",
    "slug": "kuran-kerim-diyor",
    "scheme": "kuran-kerim-diyor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#b69a73"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kurankerimdiyor",
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": ["applinks:kurannediyor.com.tr"]
    },
    "android": {
      "package": "com.kurankerimdiyor",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kurannediyor.com.tr",
              "pathPrefix": "/ayet"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-localization",
      "expo-notifications",
      [
        "@bittingz/expo-widgets",
        {
          "ios": {
            "src": "./widgets/ios",
            "devTeamId": "enesakca04",
            "mode": "production"
          },
          "android": {
            "src": "./widgets",
            "widgets": [
              {
                "name": "VerseWidget",
                "resourceName": "@xml/verse_widget_info"
              }
            ]
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cc7bed36-1460-4f3c-84ff-3d98b7c27429"
      }
    },
    "owner": "enesakca04"
  }
}
