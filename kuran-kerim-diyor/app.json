{
  "expo": {
    "name": "Kur'an Ne Diyor?",
    "slug": "kuran-kerim-diyor",
    "scheme": "kuran-kerim-diyor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-v2.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/android-icon-foreground-v2.png",
      "resizeMode": "contain",
      "backgroundColor": "#003B49"
    },
    "notification": {
      "icon": "./assets/android-icon-foreground-v2.png",
      "color": "#D6A94F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kurankerimdiyor",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 1,
      "package": "com.kurankerimdiyor",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#003B49",
        "foregroundImage": "./assets/android-icon-foreground-v2.png",
        "monochromeImage": "./assets/android-icon-foreground-v2.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-localization",
      "expo-notifications",
      [
        "@bittingz/expo-widgets",
        {
          "android": {
            "src": "./widgets",
            "widgets": [
              {
                "name": "VerseWidget",
                "resourceName": "@xml/verse_widget_info"
              }
            ]
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cc7bed36-1460-4f3c-84ff-3d98b7c27429"
      }
    },
    "owner": "zafergunes"
  }
}
