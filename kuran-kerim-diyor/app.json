{
  "expo": {
    "name": "Kur'an Ne Diyor?",
    "slug": "kuran-kerim-diyor",
    "scheme": "kuran-kerim-diyor",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-v2.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kurankerimdiyor",
      "buildNumber": "10",
      "appleTeamId": "CD5FK55DWW",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "versionCode": 10,
      "package": "com.kurankerimdiyor",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#003B49",
        "foregroundImage": "./assets/android-icon-foreground-v2.png",
        "monochromeImage": "./assets/android-icon-foreground-v2.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/android-icon-foreground-v2.png",
          "resizeMode": "contain",
          "backgroundColor": "#003B49"
        }
      ],
      "expo-status-bar",
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false,
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "tr",
              "en",
              "ar",
              "de",
              "fr",
              "es"
            ],
            "android": [
              "tr",
              "en",
              "ar",
              "de",
              "fr",
              "es"
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-foreground-v2.png",
          "color": "#D6A94F",
          "mode": "production"
        }
      ],
      [
        "@bittingz/expo-widgets",
        {
          "ios": {
            "src": "./widgets/ios",
            "devTeamId": "CD5FK55DWW",
            "deploymentTarget": "16.2",
            "mode": "production",
            "useLiveActivities": false,
            "frequentUpdates": false,
            "xcode": {
              "widgetBundleIdentifier": "com.kurankerimdiyor.widget",
              "appExtAPI": true
            }
          },
          "android": {
            "src": "./widgets",
            "widgets": [
              {
                "name": "VerseWidget",
                "resourceName": "@xml/verse_widget_info"
              }
            ]
          }
        }
      ]
    ],
    "locales": {
      "tr": "./locales/app-metadata-tr.json",
      "en": "./locales/app-metadata-en.json",
      "ar": "./locales/app-metadata-ar.json",
      "de": "./locales/app-metadata-de.json",
      "fr": "./locales/app-metadata-fr.json",
      "es": "./locales/app-metadata-es.json"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cc7bed36-1460-4f3c-84ff-3d98b7c27429"
      }
    },
    "owner": "zafergunes"
  }
}