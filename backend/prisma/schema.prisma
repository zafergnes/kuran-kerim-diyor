generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String       @id @default(uuid())
  email              String       @unique
  password           String
  name               String?
  isGuest            Boolean      @default(false)
  deviceId           String?
  isDeleted          Boolean      @default(false)
  deletedAt          DateTime?
  reactivatedAt      DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  role               String       @default("USER") // USER, ADMIN
  isBanned           Boolean      @default(false)
  invalidReportCount Int          @default(0)
  progress           UserProgress?
  collections        Collection[]
  comments           Comment[]
  favorites          Favorite[]
  reports            Report[]
  likes              CommentLike[]
  pushDevices        PushDevice[]
  webPushSubscriptions WebPushSubscription[]
  aiFeedback         AiFeedback[]
  appEvents          AppEvent[]
  adminAuditLogs     AdminAudit[] @relation("AdminActor")
  blocksInitiated    UserBlock[] @relation("Blocker")
  blocksReceived     UserBlock[] @relation("Blocked")
}

model AiFeedback {
  id           Int      @id @default(autoincrement())
  responseId   String   @unique
  userId       String?
  surahNumber  Int
  ayahNumber   Int
  reason       String
  details      String?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model AppEvent {
  id         Int      @id @default(autoincrement())
  event      String
  installId  String
  sessionId  String
  platform   String
  appVersion String?
  screen     String?
  metadata   Json?
  userId     String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([event, createdAt])
  @@index([installId, createdAt])
  @@index([sessionId, createdAt])
  @@index([userId])
}

model AdminAudit {
  id          Int      @id @default(autoincrement())
  adminUserId String
  action      String
  targetType  String
  targetId    String
  details     Json?
  createdAt   DateTime @default(now())
  admin       User     @relation("AdminActor", fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([adminUserId, createdAt])
}

model UserBlock {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

model SystemSetting {
  key          String   @id
  value        String
  updatedById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([updatedAt])
}

model SupportRequest {
  id              String   @id @default(uuid())
  accessTokenHash String
  email           String?
  category        String
  message         String
  locale          String   @default("tr")
  status          String   @default("OPEN")
  adminNote       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

model Report {
  id        Int      @id @default(autoincrement())
  commentId Int
  userId    String
  reason    String
  createdAt DateTime @default(now())
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
}

model Favorite {
  id          Int              @id @default(autoincrement())
  userId      String
  ayahId      String
  surahNumber Int
  ayahNumber  Int
  createdAt   DateTime         @default(now())
  collections CollectionItem[]
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ayahId])
}

model Collection {
  id        Int              @id @default(autoincrement())
  name      String
  userId    String
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CollectionItem[]
}

model CollectionItem {
  collectionId Int
  favoriteId   Int
  createdAt    DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  favorite     Favorite   @relation(fields: [favoriteId], references: [id], onDelete: Cascade)

  @@id([collectionId, favoriteId])
}

model Comment {
  id               Int      @id @default(autoincrement())
  userId           String
  ayahId           String
  text             String
  language         String   @default("tr")
  status           String   @default("PENDING") // PENDING, APPROVED, REJECTED, REMOVED_BY_MODERATOR
  moderationReason String?
  isDeleted        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent           Comment? @relation("CommentReplies", fields: [replyToId], references: [id])
  replyToId        Int?
  replies          Comment[] @relation("CommentReplies")
  reports          Report[]
  likes            CommentLike[]
}

model CommentLike {
  userId    String
  commentId Int
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
}

model AyahStat {
  ayahId        String @id
  favoriteCount Int    @default(0)
  commentCount  Int    @default(0)
  likeCount     Int    @default(0)
}

model VerseTheme {
  id           Int      @id @default(autoincrement())
  surahNumber  Int
  startAyah    Int
  endAyah      Int
  categoryKey  String   // e.g., "MOTIVATION", "PEACE", "WISDOM", "PATIENCE", "MORALITY", "PRAYER", "GRATITUDE"
  createdAt    DateTime @default(now())

  @@unique([surahNumber, startAyah, endAyah])
}

model PushDevice {
  id        String   @id @default(uuid())
  token     String   @unique
  timezone  String
  language  String   @default("tr")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WebPushSubscription {
  id        String   @id @default(uuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  timezone  String
  language  String   @default("tr")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserProgress {
  userId           String   @id
  currentSurah     Int      @default(1)
  currentAyah      Int      @default(1)
  completedSurahs  String   @default("[]") // JSON number array: [1, 2]
  seenAchievements String   @default("[]") // JSON string array: ["first_step", "faithful_reader"]
  hatimCount       Int      @default(0)    // Toplam bitirilen Hatim sayısı
  readCounts       String   @default("{}") // JSON map: { "1:1": 10, "2:255": 3 }
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
